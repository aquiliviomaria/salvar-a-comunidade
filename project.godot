; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Salvar a Comunidade"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.5")
boot_splash/bg_color=Color(0.08, 0.14, 0.12, 1)
config/icon="res://icon.svg"

[autoload]

PlayerManager="*res://scripts/player_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
ResourceManager="*res://scripts/resource_manager.gd"
MissionManager="*res://scripts/mission_manager.gd"
NPCManager="*res://scripts/npc_manager.gd"
AnimalManager="*res://scripts/animal_manager.gd"
IconManager="*res://scripts/icon_manager.gd"
ToolManager="*res://scripts/tool_manager.gd"
ConstructionManager="*res://scripts/construction_manager.gd"
SoundManager="*res://scripts/sound_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

